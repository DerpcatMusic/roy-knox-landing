---
import Button from "../ui/Button.astro";
import HeroVideo from "./HeroVideo.astro";
import LabelMarquee from "../sections/LabelMarquee.astro";
---

<section class="hero grain" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true">
    <HeroVideo />
    <div class="hero__scrim" />
  </div>

  <div class="container hero__content">
    <div class="hero__copy">
      <h1 id="hero-title" class="hero__title">
        <span class="hero__title-line">ROY</span>
        <span class="hero__title-line hero__title-line--split">KNOX</span>
      </h1>

      <p class="hero__desc prose-muted">
        Bass-EDM producer known for emotions infused energetic sound. Melodic lines
        that detonate into bass — from <em>Lost in Sound</em> to
        <em>Reach the Stars</em>.
      </p>

      <div class="hero__actions">
        <Button href="#music" variant="primary" size="lg">Listen now</Button>
        <Button href="#live" variant="ghost" size="lg">See live dates</Button>
      </div>
    </div>
  </div>

  <LabelMarquee overlay />
</section>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    max-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: var(--size-20);
    padding-bottom: calc(var(--size-16) + var(--space-md));
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: var(--z-base);
    pointer-events: none;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, oklch(0.09 0.004 260 / 0.72) 0%, oklch(0.09 0.004 260 / 0.45) 55%, oklch(0.09 0.004 260 / 0.82) 100%),
      oklch(0.09 0.004 260 / 0.55);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    max-width: 44rem;
    animation: reveal-up var(--duration-slow) var(--ease-out-quart) both;
  }

  .hero__title {
    font-size: var(--text-display);
    font-weight: 400;
    line-height: var(--leading-solid);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .hero__title-line {
    display: block;
  }

  .hero__title-line--split {
    color: var(--color-flame);
  }

  .hero__desc {
    margin-top: var(--space-lg);
    font-size: var(--text-lg);
    line-height: 1.46;
    max-width: 52ch;
  }

  .hero__desc em {
    font-style: italic;
    color: var(--color-ink);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-xl);
  }
</style>
