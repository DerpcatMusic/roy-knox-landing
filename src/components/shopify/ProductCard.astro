---
import type { Product } from "../../lib/shopify/types";
import { formatMoney } from "../../lib/shopify/format";
import AddToCartForm from "./AddToCartForm.svelte";
import ShopifyImage from "./ShopifyImage.svelte";

interface Props {
  product: Product;
  index?: number;
}

const { product, index = 0 } = Astro.props;
const variant = product.variants.nodes[0];
---

<li class="product-card" style={`--i: ${index}`}>
  <article class="product-card__inner">
    <a href={`/shop/${product.handle}`} class="product-card__media">
      <ShopifyImage
        client:visible
        image={product.featuredImage}
        class="product-card__image"
        loading={index < 3 ? "eager" : "lazy"}
        sizes="(min-width: 1024px) 320px, (min-width: 768px) 45vw, 80vw"
      />
    </a>

    <div class="product-card__body">
      <a href={`/shop/${product.handle}`} class="product-card__title">
        {product.title}
      </a>

      {variant && (
        <p class="product-card__price">{formatMoney(variant.price)}</p>
      )}

      {variant && (
        <AddToCartForm
          client:visible
          variantId={variant.id}
          variantQuantityAvailable={variant.quantityAvailable}
          variantAvailableForSale={variant.availableForSale}
        />
      )}
    </div>
  </article>
</li>

<style>
  .product-card {
    list-style: none;
    scroll-snap-align: start;
    animation: reveal-up var(--duration-slow) var(--ease-out-quart) both;
    animation-delay: calc(var(--i, 0) * 80ms);
  }

  .product-card__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-bg);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .product-card__media {
    position: relative;
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    text-decoration: none;
    background: var(--color-surface);
  }

  .product-card__image,
  .product-card__media :global(img),
  .product-card__media :global(.shopify-image-placeholder) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-lg);
    flex: 1;
    border-top: 1px solid var(--color-border);
  }

  .product-card__title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out-quart);
  }

  .product-card__title:hover {
    color: var(--color-flame);
  }

  .product-card__price {
    margin: 0;
    font-size: var(--text-body);
    font-weight: 500;
    color: var(--color-ink-muted);
  }
</style>
