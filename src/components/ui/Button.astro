---
interface Props {
  href: string;
  variant?: "primary" | "ghost" | "ember";
  size?: "md" | "lg";
  external?: boolean;
  class?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  external = false,
  class: className = "",
} = Astro.props;
---

<a
  href={href}
  class:list={["btn", `btn--${variant}`, `btn--${size}`, className]}
  {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
>
  <span class="btn__fx" aria-hidden="true"></span>
  <span class="btn__label"><slot /></span>
</a>

<script>
  import { gsap } from "gsap";

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const turbulence = document.querySelector<SVGFETurbulenceElement>("#rk-button-distort feTurbulence");
  const displacement = document.querySelector<SVGFEDisplacementMapElement>("#rk-button-distort feDisplacementMap");

  if (turbulence && displacement && !reduceMotion.matches) {
    document.querySelectorAll<HTMLElement>(".btn").forEach((button) => {
      button.addEventListener("pointerenter", () => {
        gsap.to(turbulence, {
          attr: { baseFrequency: "0.035 0.22" },
          duration: 0.22,
          ease: "power3.out",
        });
        gsap.to(displacement, {
          attr: { scale: 16 },
          duration: 0.22,
          ease: "power3.out",
        });
      });

      button.addEventListener("pointerleave", () => {
        gsap.to(turbulence, {
          attr: { baseFrequency: "0.012 0.08" },
          duration: 0.36,
          ease: "power3.out",
        });
        gsap.to(displacement, {
          attr: { scale: 3 },
          duration: 0.36,
          ease: "power3.out",
        });
      });
    });
  }
</script>

<style>
  .btn {
    --btn-bg: var(--color-ink);
    --btn-fg: var(--color-bg);
    --btn-border: var(--color-ink);
    --btn-glow: oklch(0.72 0.2 244 / 0.36);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    font-family: var(--font-label);
    font-weight: 700;
    letter-spacing: var(--tracking-ui);
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid var(--btn-border);
    border-radius: var(--radius-2);
    color: var(--btn-fg);
    background:
      linear-gradient(135deg, oklch(1 0 0 / 0.18), transparent 34%),
      var(--btn-bg);
    box-shadow: inset 0 0 0 1px oklch(1 0 0 / 0.1);
    clip-path: polygon(
      0 var(--size-2),
      var(--size-2) 0,
      100% 0,
      100% calc(100% - var(--size-2)),
      calc(100% - var(--size-2)) 100%,
      0 100%
    );
    transition:
      color var(--duration-base) var(--ease-out-quart),
      border-color var(--duration-base) var(--ease-out-quart),
      transform var(--duration-base) var(--ease-out-quart),
      clip-path var(--duration-base) var(--ease-out-quart);
    cursor: pointer;
    white-space: nowrap;
  }

  .btn::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      repeating-linear-gradient(
        112deg,
        oklch(1 0 0 / 0.2) 0 0.0625rem,
        transparent 0.0625rem 0.4375rem
      );
    opacity: 0.16;
    mix-blend-mode: overlay;
  }

  .btn::after {
    content: "";
    position: absolute;
    inset: auto 14% 0;
    z-index: -1;
    height: 0.125rem;
    background: var(--color-ink);
    opacity: 0.85;
    box-shadow: 0 0 var(--size-5) currentColor;
    transform: scaleX(0.36);
    transform-origin: center;
    transition:
      opacity var(--duration-base) var(--ease-out-quart),
      transform var(--duration-base) var(--ease-out-quart);
  }

  .btn__label {
    position: relative;
    z-index: 1;
    transform: translateZ(0);
    transition:
      letter-spacing var(--duration-base) var(--ease-out-quart),
      transform var(--duration-base) var(--ease-out-quart);
  }

  .btn__fx {
    position: absolute;
    inset: -55% -20% -35%;
    z-index: -1;
    opacity: 0;
    background:
      radial-gradient(ellipse at 32% 88%, oklch(0.78 0.13 88 / 0.9), transparent 18%),
      radial-gradient(ellipse at 52% 92%, oklch(0.72 0.2 244 / 0.98), transparent 25%),
      radial-gradient(ellipse at 70% 86%, oklch(0.94 0.004 260 / 0.74), transparent 13%),
      conic-gradient(from 220deg at 50% 86%, transparent 0 16%, oklch(0.72 0.2 244 / 0.7), transparent 34% 52%, oklch(0.78 0.13 88 / 0.74), transparent 70%);
    filter: url("#rk-button-distort") blur(0.02rem) saturate(1.55);
    transform: translate3d(-4%, 38%, 0) rotate(-3deg) scale(0.88);
    transition:
      opacity var(--duration-base) var(--ease-out-quart),
      transform var(--duration-slow) var(--ease-out-quart);
  }

  .btn--md {
    min-height: 2.75rem;
    padding: var(--size-3) var(--size-6);
    font-size: var(--text-sm);
  }

  .btn--lg {
    min-height: 3.25rem;
    padding: var(--size-4) var(--size-10);
    font-size: var(--text-body);
  }

  .btn--primary {
    --btn-bg: var(--color-flame);
    --btn-fg: var(--color-bg);
    --btn-border: var(--color-flame);
    --btn-glow: oklch(0.72 0.2 244 / 0.28);
  }

  .btn--primary:hover {
    --btn-bg: var(--color-ink);
    --btn-border: var(--color-ink);
    --btn-glow: oklch(0.72 0.2 244 / 0.5);
  }

  .btn--ghost {
    --btn-bg: oklch(0.94 0.004 260 / 0.03);
    --btn-fg: var(--color-ink);
    --btn-border: var(--color-border-strong);
    --btn-glow: oklch(0.04 0.004 260 / 0);
    backdrop-filter: blur(var(--size-2));
  }

  .btn--ghost:hover {
    --btn-border: var(--color-flame);
    --btn-glow: oklch(0.72 0.2 244 / 0.3);
    color: var(--color-ink);
  }

  .btn--ember {
    --btn-bg: var(--color-ember);
    --btn-fg: var(--color-bg);
    --btn-border: var(--color-ember);
    --btn-glow: oklch(0.78 0.13 88 / 0.24);
  }

  .btn--ember:hover {
    --btn-bg: var(--color-ink);
    --btn-border: var(--color-ink);
    --btn-glow: oklch(0.78 0.13 88 / 0.42);
  }

  .btn:hover {
    clip-path: polygon(
      0 var(--size-3),
      var(--size-3) 0,
      100% 0,
      100% calc(100% - var(--size-3)),
      calc(100% - var(--size-3)) 100%,
      0 100%
    );
    box-shadow: inset 0 0 0 1px oklch(1 0 0 / 0.16);
    transform: translateY(-0.15625rem);
  }

  .btn:hover::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .btn:hover .btn__label {
    letter-spacing: calc(var(--tracking-ui) + 0.025em);
    transform: translateY(-0.03125rem);
  }

  .btn:hover .btn__fx {
    opacity: 0.82;
    transform: translate3d(2%, -8%, 0) rotate(2deg) scale(1.08);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn,
    .btn:hover,
    .btn__label,
    .btn__fx {
      transform: none;
      transition: none;
    }
  }
</style>
