---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__name">ROY KNOX</p>
      <p class="site-footer__tagline prose-muted">
        Melodic bass, blue flame, and piano under pressure.
      </p>
    </div>

    <div class="site-footer__links">
      <a href="https://open.spotify.com/artist/6rADW3yvxPKpxWuNUKEed3" target="_blank" rel="noopener noreferrer">Spotify</a>
      <a href="https://soundcloud.com/royknox" target="_blank" rel="noopener noreferrer">SoundCloud</a>
      <a href="https://www.instagram.com/royknoxmusic/" target="_blank" rel="noopener noreferrer">Instagram</a>
      <a href="mailto:vu@royknoxmusic.com">Booking</a>
    </div>

    <p class="site-footer__copy prose-muted">
      © {year} ROY KNOX
    </p>
  </div>
</footer>

<style>
  .site-footer {
    position: sticky;
    bottom: 0;
    z-index: 0;
    min-height: min(34rem, 72dvh);
    display: flex;
    align-items: end;
    padding-block: var(--space-3xl) var(--space-2xl);
    background: var(--color-surface);
  }

  .site-footer__inner {
    position: relative;
    display: grid;
    gap: var(--space-2xl);
  }

  .site-footer__name {
    font-family: var(--font-display);
    font-size: clamp(2rem, 7vw, 5rem);
    font-weight: 500;
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
  }

  .site-footer__tagline {
    margin-top: var(--space-xs);
    font-size: var(--text-lg);
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-xl);
  }

  .site-footer__links a {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: var(--tracking-ui);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-ink);
    transition:
      color var(--duration-base) var(--ease-out-quart),
      transform var(--duration-base) var(--ease-out-quart);
  }

  .site-footer__links a:hover {
    color: var(--color-flame);
    transform: translateY(-0.125rem);
  }

  .site-footer__copy {
    font-size: var(--text-caption);
  }

  @media (min-width: 768px) {
    .site-footer__inner {
      grid-template-columns: 1fr auto;
      align-items: end;
    }

    .site-footer__copy {
      grid-column: 1 / -1;
    }
  }

  @supports not (position: sticky) {
    .site-footer {
      position: relative;
    }
  }
</style>
