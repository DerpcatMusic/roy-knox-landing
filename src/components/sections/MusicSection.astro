---
import SectionHeading from "../ui/SectionHeading.astro";
import ReleaseRow from "../music/ReleaseRow.astro";
import { getReleases } from "../../lib/spotify/getReleases";

const { releases, source } = await getReleases();
---

<section id="music" class="section music">
  <div class="container">
    <SectionHeading
      title="Discography"
      subtitle="Monstercat, Ophelia, Insomniac, NCS — and support from Seven Lions, Illenium, Said The Sky, and more."
    />

    {source !== "unavailable" ? (
      <ol class="music__list">
        {
          releases.map((release, i) => (
            <ReleaseRow
              title={release.title}
              label={release.label}
              releaseDate={release.releaseDate}
              artworkUrl={release.artworkUrl}
              href={release.href}
              index={i}
            />
          ))
        }
      </ol>
    ) : (
      <div class="music__empty" role="status">
        <p class="music__empty-title">Latest releases are unavailable.</p>
        <p class="music__empty-copy prose-muted">
          Release data is temporarily unavailable. Check back soon.
        </p>
      </div>
    )}
  </div>
</section>

<style>
  .music__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .music__empty {
    max-width: 44rem;
    padding: var(--space-xl);
    border: 1px solid var(--color-border-flame);
    border-radius: var(--radius-lg);
    background: oklch(0.72 0.2 244 / 0.055);
  }

  .music__empty-title {
    font-family: var(--font-display);
    font-size: var(--text-subhead);
    font-weight: 500;
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
  }

  .music__empty-copy {
    margin-top: var(--space-md);
  }
</style>
