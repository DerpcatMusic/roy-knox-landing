---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/layout/SiteHeader.astro";
import SiteFooter from "../../components/layout/SiteFooter.astro";
import AddToCartForm from "../../components/shopify/AddToCartForm.svelte";
import ShopifyImage from "../../components/shopify/ShopifyImage.svelte";
import { formatMoney } from "../../lib/shopify/format";
import { getProductByHandle, getProducts } from "../../lib/shopify/client";
import { isShopifyConfigured } from "../../lib/shopify/config";

export async function getStaticPaths() {
  if (!isShopifyConfigured()) {
    return [];
  }

  const products = await getProducts({ limit: 100 });
  return products.map((product) => ({
    params: { handle: product.handle },
    props: { product },
  }));
}

interface Props {
  product: NonNullable<Awaited<ReturnType<typeof getProductByHandle>>>;
}

const { product } = Astro.props;
const variant = product.variants.nodes[0]!;
---

<BaseLayout title={`${product.title} — ROY KNOX`}>
  <SiteHeader />
  <main class="shop-product">
    <div class="container shop-product__inner">
      <nav class="shop-product__breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/#merch">Merch</a>
        <span aria-hidden="true">/</span>
        <span>{product.title}</span>
      </nav>

      <div class="shop-product__layout">
        <div class="shop-product__gallery">
          <ShopifyImage
            client:load
            image={product.featuredImage}
            class="shop-product__hero-image"
            loading="eager"
            sizes="(min-width: 1024px) 50vw, 100vw"
          />
        </div>

        <div class="shop-product__info">
          <h1 class="shop-product__title">{product.title}</h1>
          <p class="shop-product__price">{formatMoney(variant.price)}</p>

          <AddToCartForm
            client:load
            variantId={variant.id}
            variantQuantityAvailable={variant.quantityAvailable}
            variantAvailableForSale={variant.availableForSale}
          />
        </div>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .shop-product {
    padding-block: calc(var(--space-3xl) + 4rem) var(--space-3xl);
  }

  .shop-product__breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  .shop-product__breadcrumb a {
    text-decoration: none;
  }

  .shop-product__layout {
    display: grid;
    gap: var(--space-2xl);
  }

  @media (min-width: 900px) {
    .shop-product__layout {
      grid-template-columns: 1.1fr 0.9fr;
      align-items: start;
    }
  }

  .shop-product__gallery {
    overflow: hidden;
    aspect-ratio: 1;
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface);
  }

  .shop-product__hero-image,
  .shop-product__gallery :global(img),
  .shop-product__gallery :global(.shopify-image-placeholder) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shop-product__title {
    font-size: var(--text-headline);
    margin-bottom: var(--space-md);
  }

  .shop-product__price {
    margin: 0 0 var(--space-xl);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-flame);
  }
</style>
